+  it('runs a SessionEnd hook when a session is disposed, reporting its id and reason "other"', async () => {
+    const dir = mkdtempSync(join(tmpdir(), 'dsh-hooks-claude-'))
+    dirs.push(dir)
+    const capture = join(dir, 'captured.json')
+    const hook = join(dir, 'end.sh')
+    writeFileSync(hook, `#!/usr/bin/env bash\ncat > "${capture}.tmp"; mv "${capture}.tmp" "${capture}"\n`)
+    chmodSync(hook, 0o755)
+    writeFileSync(join(dir, 'hooks.json'), JSON.stringify({ hooks: { SessionEnd: [{ hooks: [{ type: 'command', command: hook }] }] } }))
+
+    const ctx = await harness(dir, new MockAdapter([]))
+    const session = ctx.sessions.create(SessionId('ending'))
+    // 'session/disposed' is an observe-only teardown notification — drive it
+    // directly the same way the SubagentStart/Stop tests drive their lifecycle
+    // events, rather than tearing down the whole fiber.
+    ctx.emit('session/disposed', session)
+
+    await waitFor(() => existsSync(capture))
+    const payload = JSON.parse(readFileSync(capture, 'utf8')) as Record<string, unknown>
+    expect(payload['hook_event_name']).toBe('SessionEnd')
+    expect(payload['session_id']).toBe('ending')
+    expect(payload['reason']).toBe('other')
+    expect(payload['transcript_path']).toBe('')
+    await ctx.fiber.dispose()
+  })
+
