+    const dir = mkdtempSync(join(tmpdir(), 'dsh-hooks-claude-'))
+    dirs.push(dir)
+    const marker = join(dir, 'ran')
+    const hook = join(dir, 'end.sh')
+    writeFileSync(hook, `#!/usr/bin/env bash\ntouch "${marker}"\n`)
+    chmodSync(hook, 0o755)
+    // SessionEnd has no matcher subject (like UserPromptSubmit/Stop); a stray
+    // `matcher` field here must not stop the hook from registering and running.
+    writeFileSync(join(dir, 'hooks.json'), JSON.stringify({ hooks: { SessionEnd: [{ matcher: 'ignored', hooks: [{ type: 'command', command: hook }] }] } }))
+
+    const ctx = await harness(dir, new MockAdapter([]))
+    const session = ctx.sessions.create(SessionId('ending-2'))
+    ctx.emit('session/disposed', session)
+
+    await waitFor(() => existsSync(marker))
+    expect(existsSync(marker)).toBe(true)
+    await ctx.fiber.dispose()
+  })
